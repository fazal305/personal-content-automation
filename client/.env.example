# Copy this file to .env and fill in real values. Never commit .env.

# Must match the API_KEY set in the server's .env — baked into the client
# bundle at build time and sent as the X-API-Key header on every request.
# This is a trusted single-user local tool (only you ever see the bundle),
# so a build-time env var is an acceptable place to keep it.
VITE_API_KEY=

# Override if the API isn't on the default local port.
# VITE_API_URL=http://localhost:4000/api

# Copy this file to .env and fill in real values. Never commit .env.

# --- Server ---
PORT=4000
DATABASE_PATH=./data/content.db

# --- Safety switches ---
# When true, scheduled jobs run through the full pipeline but no external API is called.
DRY_RUN=true
# When true, the app seeds/serves demo data instead of your real content.
DEMO_MODE=true

# --- AI assistant (optional — leave blank to disable AI features entirely) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# --- GitHub (content-idea trigger: releases, README changes, etc.) ---
GITHUB_TOKEN=
GITHUB_USERNAME=

# --- Mastodon (real automation: publish + analytics) ---
MASTODON_INSTANCE_URL=
MASTODON_ACCESS_TOKEN=

# --- Bluesky / AT Protocol (real automation: publish + analytics) ---
BLUESKY_IDENTIFIER=
BLUESKY_APP_PASSWORD=

# --- Threads (real automation: publish + analytics, Dev Mode self-use) ---
THREADS_USER_ID=
THREADS_ACCESS_TOKEN=

# LinkedIn and Instagram are manual-assist / copy-ready only in this system —
# no API credentials are used for them. See docs/api-research.md.
